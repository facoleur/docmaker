# Mot de passe du compte de lecture sur le datamart (étape recon).
ORACLE_PASSWORD=

# OpenMetadata (src/eval, src/sources, src/sink) : instance locale par défaut
# (docker-compose dans openmetadata/), à remplacer par le JWT du bot d'ingestion.
OMD_HOST_PORT=http://localhost:8585/api
OMD_JWT_TOKEN=

# Identité (champ updatedBy) reconnue par src/sink/omd.py comme "pas une
# correction humaine" — à aligner avec le compte de service qui authentifie
# OMD_JWT_TOKEN. Voir l'avertissement de bootstrap dans src/sink/omd.py.
OMD_BOT_USER=

# Tag ajouté aux descriptions écrites par le pipeline, pour signaler qu'elles
# restent à valider par un humain (optionnel, valeur par défaut ci-dessous).
OMD_REVIEW_TAG_FQN=Draft

# LLM pour src/enrich/describe.py — "ollama" (défaut, local, aucune donnée ne
# sort du réseau de la banque) ou "openrouter" (réutilise LLM_API_KEY ci-dessus ;
# tests/dev sur données non sensibles UNIQUEMENT, jamais en prod).
LLM_API_KEY=sk-or-...
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
